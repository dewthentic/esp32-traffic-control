#include "PED_Buzzer.h"

PED_Buzzer::PED_Buzzer(int buzzerPin) {
    PIN_BUZZER = buzzerPin;
}

void PED_Buzzer::Initialize() {
    m_isBuzzing = false;
}

void PED_Buzzer::Update() {
    // update loops continuously per second
    // use it as a router to track current enum state
    // and trigger the correct function at the correct time
    if (m_currentState == BURST) {
        BurstHandler();
    } else if (m_currentState == COUNTDOWN) {
        PingHandler();
    }
}

// allows external functions to change the state of the buzzer
void PED_Buzzer::ChangeState(int state) {
    // bounds checking on requested state
        // we won't trigger functions here, 
        // update() is responsible for listening
    switch (state) {
        case 0:
            m_currentState = OFF;
            // no pinging
            break;
        case 1:
            m_currentState = BURST;
            // ~9 pings per second
            // use with walk sign
            break;
        case 2:
            m_currentState = COUNTDOWN;
            // 1 ping per second
            // use with countdown and flashing hand/don't walk sign
            break;
        case 3:
            m_currentState = IDLE;
            // 1 ping per second
            // constant pinging to act as a sound beacon
            // to assist blind pedestrians locating intersections
            break;
        default:
            // keep the current state
    }

    // if out of bounds, you can print a warning to a log
}

void PED_Buzzer::TriggerPing() {
    if (m_currentState = COUNTDOWN) {
        // check if the current state is a countdown
        // 1 ping per second (limited)
        PingHandler(); // pings once

        if (m_accessibilityMode) { // after countdown ends
            m_currentState = IDLE;
        } else {
            m_currentState = OFF;
        }

    } else if (m_currentState == IDLE) {
        // or pinging idly to assist blind pedestrians?
        // 1 ping per second (unlimited until interrupted regardless of light interval)
        while (m_currentState == IDLE) {
            PingHandler(); // pings once a second as long as state is still idle
        }
    }
    
}

void PED_Buzzer::TriggerBurst(int amt) {
    int amtToBurst = amt; // how many waves of ~9 pings per second there should be
    m_currentState = BURST; // update current state (begin burst)

    BurstHandler(); // pinging happens in the private function

    m_currentState = OFF; // burst ended
}

// private helper functions
void PED_Buzzer::BurstHandler() {
    
    if (millis() >= m_nextEventTime) {
        digitalWrite(PIN_BUZZER, HIGH);
        m_buzzerStartedAt = millis();
        m_pulseOffTime = m_buzzerStartedAt + PULSE_DURATION;
    }
    
    if (millis() >= m_pulseOffTime) {
        digitalWrite(PIN_BUZZER, LOW);
        m_nextEventTime += BURST_INTERVAL;
    }
}

void PED_Buzzer::PingHandler() {
    if (millis() >= m_nextEventTime) {
        digitalWrite(PIN_BUZZER, HIGH);
        m_buzzerStartedAt = millis();
        m_pulseOffTime = m_buzzerStartedAt + PULSE_DURATION;
    }
    
    if (millis() >= m_pulseOffTime) {
        digitalWrite(PIN_BUZZER, LOW);
        m_nextEventTime += COUNT_INTERVAL;
    }
}